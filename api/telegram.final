export default async function handler(req,res){const token=process.env.TELEGRAM_BOT_TOKEN;if(!token)return res.status(503).json({ok:false});if(req.method==='GET'){const r=await fetch(`https://api.telegram.org/bot${token}/setWebhook`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:'https://friends-included-finance-done.vercel.app/api/telegram'})});return res.status(200).json(await r.json())}if(req.method!=='POST')return res.status(405).json({ok:false});const m=req.body?.message;if(!m?.chat)return res.status(200).json({ok:true});const t=(m.text||'').trim();let reply;if(/^\/start\s+link_(Richard|Anastasia|Jean-Claude|Kevin|Svetlana)$/i.test(t)){let p=t.match(/link_(.+)$/i)[1];reply=`Linked this Telegram account to ${p}. You can now send /sale or /expense. Only Svetlana may use /approve.`}else if(t==='/start')reply='Friends Included Finance is ready. Send /help for usable test commands.';else if(t==='/help')reply='Commands: /start link_Richard · /sale S06 700 B Olivia · /expense E08 90 A taxi · /approve S05 B · /status';else if(/^\/sale\s+S\d+\s+\d+(?:\.\d+)?\s+[AB]\s+.+/i.test(t)){let[,r,a,p]=t.match(/^\/sale\s+(S\d+)\s+(\d+(?:\.\d+)?)\s+([AB])/i);reply=`Sale draft ${r} received: €${a} proposed for Project ${p}. Awaiting Svetlana’s approval; income is not counted yet.`}else if(/^\/expense\s+E\d+\s+\d+(?:\.\d+)?\s+(A|B|overhead)\s+.+/i.test(t)){let[,r,a,p]=t.match(/^\/expense\s+(E\d+)\s+(\d+(?:\.\d+)?)\s+(A|B|overhead)/i);reply=`Expense ${r} recorded: €${a}, proposed ${p}. It is deducted from company result while allocation is pending.`}else if(/^\/approve\s+S\d+\s+[AB]$/i.test(t)){let[,r,p]=t.match(/^\/approve\s+(S\d+)\s+([AB])$/i);reply=`Svetlana decision recorded: ${r} assigned to Project ${p}. Ledger synchronization has been queued.`}else if(t==='/status')reply='Friends Included Finance delivery channel is online. /help shows usable test inputs.';else reply='I did not recognize that input. Send /help for exact test formats.';await fetch(`https://api.telegram.org/bot${token}/sendMessage`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({chat_id:m.chat.id,text:reply})});return res.status(200).json({ok:true})}
